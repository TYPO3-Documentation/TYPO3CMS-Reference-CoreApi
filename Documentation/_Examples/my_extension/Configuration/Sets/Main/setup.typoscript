lib.contentElement {
  templateRootPaths {
    200 = EXT:my_extension/Resources/Private/Templates/ContentElements/
  }
}

tt_content {
  myextension_basiccontent =< lib.contentElement
  myextension_basiccontent {
    templateName = BasicContent
  }
}

tt_content {
  myextension_newcontentcsv =< lib.contentElement
  myextension_newcontentcsv {
    templateName = DataProcCsv
    dataProcessing.10 = comma-separated-value
    dataProcessing.10 {
      fieldName = bodytext
      fieldDelimiter.field = myextension_separator
      fieldEnclosure = "
      maximumColumns.field = imagecols
      as = myTable
    }
  }
}

plugin.tx_seo.config.xmlSitemap.sitemaps.events {
    provider = MyVendor\MyExtension\XmlSitemap\EventProvider
    config {
        pid = 42
        detailPid = 43
    }
}
